{
  "version": 1,
  "author": "Smart Gym",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pir-motion-sensor", "id": "pir1", "top": -120, "left": 180, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r1", "top": 140, "left": 160, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led1", "top": 60, "left": 220, "attrs": { "color": "red" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "pir1:VCC", "esp:5V", "red", [] ],
    [ "pir1:GND", "esp:GND.2", "black", [] ],
    [ "pir1:OUT", "esp:13", "green", [] ],
    [ "esp:2", "r1:1", "orange", [] ],
    [ "r1:2", "led1:A", "orange", [] ],
    [ "led1:C", "esp:GND.3", "black", [] ]
  ],
  "dependencies": {}
}
