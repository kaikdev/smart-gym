# ============================================================
# Padronização de quebras de linha
# Todo arquivo de texto fica com LF no repositório e na máquina
# de todos, independente do sistema operacional ou do core.autocrlf.
# ============================================================
* text=auto eol=lf

# Scripts do Windows precisam de CRLF para funcionar
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Scripts Unix e Gradle Wrapper sempre com LF
gradlew  text eol=lf
*.sh     text eol=lf

# ============================================================
# Arquivos binários (nunca converter nem tentar gerar diff)
# ============================================================
*.jar       binary
*.class     binary
*.keystore  binary
*.jks       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.pdf       binary
*.zip       binary
